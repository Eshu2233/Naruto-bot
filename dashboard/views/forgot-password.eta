<%~ includeFile("partials/header.eta", {
	user: user
}); %>
<%~ includeFile("partials/message.eta"); %>
<%~ includeFile("partials/title.eta", {
	icon: "fa-solid fa-brain",
	title: "Forgot Password"
}); %>

<section class="posts">
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
          <div class="card-header bg-primary text-white">
            <h3 class="card-title mb-0 fs-5"><i class="fa-solid fa-lock me-2"></i>Forgot Password</h3>
          </div>
          <div class="card-body">
            <form action="/forgot-password" method="POST">
              <div class="form-group mb-3">
                <label for="email" class="form-label fw-bold">Email Address</label>
                <input type="email" class="form-control" id="email" name="email" placeholder="Enter your registered email" required>
              </div>
              <button type="submit" id="resend-code" class="btn btn-primary w-100">Send Code</button>
              <div class="alert alert-info mt-3 mb-0">
                <p class="mb-0">
                  <i class="fas fa-info-circle me-1"></i> We will send a verification code to your registered email address.
                </p>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%~ includeFile("partials/footer.eta") %> 