 <%~ includeFile("partials/header.eta", {
	user: user
}); %>
<%~ includeFile("partials/message.eta"); %>
<%~ includeFile("partials/title.eta", {
	icon: "fas fa-shield-alt",
	title: "Verify Code"
}); %>

<section class="posts">
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
          <div class="card-header bg-primary text-white">
            <h3 class="card-title mb-0 fs-5"><i class="fas fa-key me-2"></i>Verify Security Code</h3>
          </div>
          <div class="card-body">
            <form action="/forgot-password/submit-code" method="POST">
              <div class="form-group mb-3">
                <label for="code" class="form-label fw-bold">Verification Code</label>
                <input type="text" class="form-control" id="code" name="code" placeholder="Enter the code sent to your email" required autocomplete="off">
              </div>
              <button type="submit" id="submit-code" class="btn btn-primary w-100">Submit Code</button>
            </form>

            <div class="alert alert-info mt-3 mb-0">
              <p class="mb-0">
                <i class="fas fa-info-circle me-1"></i> Enter the verification code that was sent to your registered email address.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%~ includeFile("partials/footer.eta") %>
